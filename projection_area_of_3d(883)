class Solution {
    public int projectionArea(int[][] grid) {
        int nzcount=0,col=0,row=0;
        for(int i=0;i<grid.length;i++)
        {
            int max=-1;
            for(int j=0;j<grid[0].length;j++)
            {
                if(grid[i][j]!=0)
                   nzcount++;
                if(max<grid[i][j])
                  max=grid[i][j];
            }
            col+=max;
            max=-1;
            for(int j=0;j<grid.length;j++)
            {
                if(grid[j][i]>max)
                   max=grid[j][i];
            }
            row+=max;
        }
        return (nzcount+col+row);
    }
}