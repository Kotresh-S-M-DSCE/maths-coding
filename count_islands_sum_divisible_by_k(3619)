class Solution {
    public long dfs(int[][] grid,int[][] visit,int i,int j)
    {
        if(i<0||i==grid.length||j<0||j==grid[0].length||visit[i][j]==1||grid[i][j]==0)
            return 0;
        visit[i][j]=1;
        long left=dfs(grid,visit,i,j-1);
        long up=dfs(grid,visit,i-1,j);
        long right=dfs(grid,visit,i,j+1);
        long down=dfs(grid,visit,i+1,j);
        return (grid[i][j]+left+up+right+down);
    }
    public int countIslands(int[][] grid, int k) {
        int ret=0;
        int[][] visit=new int[grid.length][grid[0].length];
        for(int i=0;i<grid.length;i++)
        {
            for(int j=0;j<grid[0].length;j++)
            {
                if(grid[i][j]!=0&&visit[i][j]==0)
                {
                    if(dfs(grid,visit,i,j)%(long)k==0)
                        ret++;
                }
            }
        }
        return ret;
    }
}