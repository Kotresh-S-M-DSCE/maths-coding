class Solution {
    public int fun(int n){
        int sum=0,rem;
        while(n>0)
        {
            rem=n%10;
            rem=rem*rem;
            sum+=rem;
            n=n/10;
        }
        return sum;
    }
    public boolean isHappy(int n) {
        while(true)
        {
            n=fun(n);
            if(n==1)
            {
                return true;
            }
            if(n==4)
            {
                return false;
            }
        }
    }
}