class Solution {
    public boolean checkPerfectNumber(int num) {
        if(num==1)
           return false;
        int a=(int)Math.sqrt(num);
        int sum=0;
        for(int i=1;i<=a;i++)
        {
            if(num%i==0)
            {
               sum+=i;
               sum+=num/i;
            }
        }
        sum-=num;
        if(sum==num)
          return true;
        return false;
    }
}