class Solution {
    StringBuilder ret=new StringBuilder();
    int max=-1;
    public void fun(int[] arr,boolean[] bool,StringBuilder sb)
    {
        if(sb.length()==4)
        {
            int mins=((sb.charAt(0)-'0')*10+(sb.charAt(1)-'0'))*60+((sb.charAt(2)-'0')*10+(sb.charAt(3)-'0'));
            if(mins>max)
            {
               max=mins;
               ret=new StringBuilder(sb.toString());
            }
            return;
        }
        for(int i=0;i<4;i++)
        {
            int flag=0;
            if(bool[i]==false)
            {
                if(sb.length()==0&&arr[i]<=2)
                   flag=1;
                else if(sb.length()==1)
                {
                    if(sb.charAt(0)=='2')
                    {
                        if(arr[i]<=3)
                           flag=1;
                    }
                    else
                        flag=1;
                }
                else if(sb.length()==2&&arr[i]<=5)
                   flag=1;
                else if(sb.length()==3)
                   flag=1;
                else{}
            }
            if(flag==1)
            {
                sb.append((char)(arr[i]+'0'));
                bool[i]=true;
                fun(arr,bool,sb);
                sb.deleteCharAt(sb.length()-1);
                bool[i]=false;
            }
        }
    }
    public String largestTimeFromDigits(int[] arr) {
        boolean[] bool=new boolean[4];
        for(int i=0;i<4;i++)
           bool[i]=false;
        fun(arr,bool,new StringBuilder());
        if(ret.length()==0)
           return "";
        ret.insert(2,':');
        return ret.toString();
    }
}