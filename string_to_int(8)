class Solution {
    public int myAtoi(String s) {
        long num=0;
        int i=0,flag=0,flag1=0;
        while(i<s.length())
        {
            while(i<s.length()&&num==0&&s.charAt(i)==' '&&flag1==0)
               i++;
            if(i==s.length())
               break;
            if(num==0&&s.charAt(i)=='-'&&flag1==0)
            {
               flag=1;
               i++;
            }
            if(i==s.length())
               break;
            if(num==0&&s.charAt(i)=='+'&&flag1==0&&flag==0)
               i++;
            if(i==s.length())
               break;
            if(Character.isDigit(s.charAt(i)))
            {
                num=num*10+(s.charAt(i)-'0');
                flag1=1;
            }
            if(num>=2147483647&&flag==0)
            {
                num=2147483647;
                break;
            }
            if(num>2147483647&&flag==1)
            {
                num=2147483648L;
                break;
            }
            if(num==2147483647&&flag==1)
            {
                num=2147483647;
                break;
            }
            if(!Character.isDigit(s.charAt(i)))
                break;
            i++;
        }
        if(flag==1)
           num=-num;
        return (int)num;
    }
}