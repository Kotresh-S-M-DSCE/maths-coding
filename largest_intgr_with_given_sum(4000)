class Solution {
    public int largestInteger(int n, int s) {
        int[] arr=new int[n];
        for(int i=0;i<n;i++)
           arr[i]=9;
        if((n*9)<s)
           return -1;
        int num=n*9,j=0;
        for(int i=n-1;i>=0;i--)
        {
            while(arr[i]!=0&&s<num)
            {
               num--;
               arr[i]--;
            }
            if(s==num)
               break;
        }
        int ret=0;
        while(j<n)
           ret=ret*10+arr[j++];
        return ret;
    }
}