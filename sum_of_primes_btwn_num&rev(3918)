class Solution {
    public int sumOfPrimesInRange(int n) {
        int temp=n,rev=0;
        if(n==1)
           return 0;
        if(n==2||n==3||n==5||n==7)
           return n;
        while(temp>0)
        {
            rev=rev*10+temp%10;
            temp/=10;
        }
        int sum=0;
        if(n>rev)
        {
            int tempo=n;
            n=rev;
            rev=tempo;
        }
        if(n==1)
        {
            n=3;
            sum=2;
        }
        if(n==2||rev==2)
            sum+=2;
        if(n%2==0)
           n=n+1;
        for(int i=n;i<=rev;i+=2)
        {
            if(i%2==0)
               break;
            int sq=(int)(Math.sqrt(i)),flag=0;
            for(int j=3;j<=sq;j+=2)
            {
                if(i%j==0)
                {
                    flag=1;
                    break;
                }
            }
            if(flag==0)
               sum+=i;
        }
        return sum;
    }
}