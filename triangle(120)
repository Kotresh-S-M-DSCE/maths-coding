class Solution {
    public int minimumTotal(List<List<Integer>> list) {
        for(int i=1;i<list.size();i++)
        {
            for(int j=0;j<list.get(i).size();j++)
            {
                int temp=list.get(i).get(j);
                if(j==0)
                   list.get(i).set(0,list.get(i-1).get(0)+temp);
                else if(j==list.get(i).size()-1)
                   list.get(i).set(j,list.get(i-1).get(j-1)+temp);
                else
                {
                    if(list.get(i-1).get(j-1)<list.get(i-1).get(j))
                       list.get(i).set(j,list.get(i-1).get(j-1)+temp);
                    else
                       list.get(i).set(j,list.get(i-1).get(j)+temp);
                }
            }
        }
        int n=100000;
        for(int i=0;i<list.get(list.size()-1).size();i++)
        {
            if(n>list.get(list.size()-1).get(i))
               n=list.get(list.size()-1).get(i);
        }
        return n;
    }
}