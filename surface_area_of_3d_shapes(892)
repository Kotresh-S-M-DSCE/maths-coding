class Solution {
    public int surfaceArea(int[][] grid) {
        int count=0;
        if(grid.length==1&&grid[0][0]==0)
            return 0;
        if(grid.length==1)
            return (2+4*(grid[0][0]));
        for(int i=0;i<grid.length;i++)
        {
            for(int j=0;j<grid.length;j++)
            {
                if(i==0&&j==0)
                {
                    if(grid[i][j]!=0)
                        count=2+2*(grid[i][j]);
                    if(grid[i][j]>grid[i][j+1])
                        count+=grid[i][j]-grid[i][j+1];
                    if(grid[i][j]>grid[i+1][j])
                        count+=grid[i][j]-grid[i+1][j];
                }
                else if(i==0&&j!=grid.length-1)
                {
                    if(grid[i][j]!=0)
                       count+=2+grid[i][j];
                    if(grid[i][j]>grid[i][j-1])
                       count+=grid[i][j]-grid[i][j-1];
                    if(grid[i][j]>grid[i+1][j])
                       count+=grid[i][j]-grid[i+1][j];
                    if(grid[i][j]>grid[i][j+1])
                       count+=grid[i][j]-grid[i][j+1];
                }
                else if(i==0&&j==grid.length-1)
                {
                    if(grid[i][j]!=0)
                        count+=2+2*(grid[i][j]);
                    if(grid[i][j]>grid[i][j-1])
                       count+=grid[i][j]-grid[i][j-1];
                    if(grid[i][j]>grid[i+1][j])
                       count+=grid[i][j]-grid[i+1][j];
                }
                else if(i!=grid.length-1&&j==0)
                {
                    if(grid[i][j]!=0)
                        count+=2+grid[i][j];
                    if(grid[i][j]>grid[i-1][j])
                        count+=grid[i][j]-grid[i-1][j];
                    if(grid[i][j]>grid[i+1][j])
                       count+=grid[i][j]-grid[i+1][j];
                    if(grid[i][j]>grid[i][j+1])
                       count+=grid[i][j]-grid[i][j+1];
                }
                else if(i==grid.length-1&&j==0)
                {
                    if(grid[i][j]!=0)
                        count+=2+2*(grid[i][j]);
                    if(grid[i][j]>grid[i-1][j])
                        count+=grid[i][j]-grid[i-1][j];
                    if(grid[i][j]>grid[i][j+1])
                       count+=grid[i][j]-grid[i][j+1];
                }
                else if(i==grid.length-1&&j!=grid.length-1)
                {
                    if(grid[i][j]!=0)
                        count+=2+grid[i][j];
                    if(grid[i][j]>grid[i-1][j])
                        count+=grid[i][j]-grid[i-1][j];
                    if(grid[i][j]>grid[i][j+1])
                       count+=grid[i][j]-grid[i][j+1];
                    if(grid[i][j]>grid[i][j-1])
                       count+=grid[i][j]-grid[i][j-1];
                }
                else if(i==grid.length-1&&j==grid.length-1)
                {
                    if(grid[i][j]!=0)
                        count+=2+2*(grid[i][j]);
                    if(grid[i][j]>grid[i-1][j])
                        count+=grid[i][j]-grid[i-1][j];
                    if(grid[i][j]>grid[i][j-1])
                       count+=grid[i][j]-grid[i][j-1];
                }
                else if(i!=grid.length-1&&j==grid.length-1)
                {
                    if(grid[i][j]!=0)
                       count+=2+grid[i][j];
                    if(grid[i][j]>grid[i-1][j])
                        count+=grid[i][j]-grid[i-1][j];
                    if(grid[i][j]>grid[i][j-1])
                       count+=grid[i][j]-grid[i][j-1];
                    if(grid[i][j]>grid[i+1][j])
                       count+=grid[i][j]-grid[i+1][j];
                }
                else
                {
                    if(grid[i][j]!=0)
                        count+=2;
                    if(grid[i][j]>grid[i-1][j])
                        count+=grid[i][j]-grid[i-1][j];
                    if(grid[i][j]>grid[i][j-1])
                       count+=grid[i][j]-grid[i][j-1];
                    if(grid[i][j]>grid[i+1][j])
                       count+=grid[i][j]-grid[i+1][j];
                    if(grid[i][j]>grid[i][j+1])
                       count+=grid[i][j]-grid[i][j+1];
                }
            }
        }
        return count;
    }
}