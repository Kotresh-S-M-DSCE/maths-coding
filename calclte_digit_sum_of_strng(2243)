class Solution {
    public String digitSum(String s, int k) {
        while(k<s.length())
        {
            StringBuilder sb=new StringBuilder();
            int i=0;
            while(i<s.length())
            {
                int sum=0,temp=i;
                while(i<s.length()&&(i<temp+k))
                    sum+=s.charAt(i++)-'0';
                sb.append(sum);
            }
            s=sb.toString();
        }
        return s;
    }
}