class Solution {
    public int fun(String str)
    {
        int num=0;
        num=(((str.charAt(0)-'0')*10)+(str.charAt(1)-'0'))*60+(((str.charAt(3)-'0')*10)+(str.charAt(4)-'0'));
        if(num==0)
           return 1440;
        return num;
    }
    public int findMinDifference(List<String> timePoints) {
        int[] arr=new int[timePoints.size()];
        int j=0;
        for(int i=0;i<timePoints.size();i++)
            arr[j++]=fun(timePoints.get(i));
        Arrays.sort(arr);
        int min=arr[1]-arr[0];
        for(int i=2;i<arr.length;i++)
        {
            if((arr[i]-arr[i-1])<min)
               min=arr[i]-arr[i-1];
        }
        int temp=1440+arr[0];
        if(min>(temp-arr[arr.length-1]))
           return (temp-arr[arr.length-1]);
        return min;
    }
}