class Solution {
    public String addBinary(String a, String b) {
        StringBuilder sb=new StringBuilder();
        int i=a.length()-1,j=b.length()-1,carry=0;
        while(i>=0||j>=0)
        {
            int sum=0;
            if(i==-1)
            {
                sum=(b.charAt(j)-'0')+carry;
                j--;
            }
            else if(j==-1)
            {
                sum=(a.charAt(i)-'0')+carry;
                i--;
            }
            else
            {
                sum=(a.charAt(i)-'0')+(b.charAt(j)-'0')+carry;
                i--;
                j--;
            }
            sb.insert(0,sum%2);
            carry=sum/2;
        }    
        if(carry==1)
            sb.insert(0,1);
        return sb.toString();   
    }
}