class Solution {
    public int arrangeCoins(int n) {
        long low=1,high=n,mid=0;
        while(low<=high)
        {
            mid=low+(high-low)/2;
            if(mid*(mid+1)/2==n)
                return (int)mid;
            else if(mid*(mid+1)/2<n)
                low=mid+1;
            else
                high=mid-1;
        }
        return (int)high;
    }
}