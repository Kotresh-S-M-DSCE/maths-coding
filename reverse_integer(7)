class Solution {
    public int reverse(int x) {
        int temp=x,rem;
        long sum=0;
        if(x<0)
          x=-x;
        while(x>0)
        {
            rem=x%10;
            sum=sum*10+rem;
            if(sum>=2147483647)
              return 0;
            x/=10;
        }
        if(temp<0)
        {
            sum=-sum;
            return (int)sum;
        }

        return (int)sum;
    }
}