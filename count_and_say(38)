class Solution {
    public String fun(int n)
    {
        if(n==1)
           return "1";
        String str=fun(n-1);
        StringBuilder sb=new StringBuilder();
        int i,count=1;
        for(i=1;i<str.length();i++)
        {
            if(str.charAt(i)==str.charAt(i-1))
               count++;
            else
            {
                sb.append(count);
                sb.append(str.charAt(i-1));
                count=1;
            }
        }
        sb.append(count);
        sb.append(str.charAt(i-1));
        return sb.toString();
    }
    public String countAndSay(int n) {
        return fun(n);
    }
}