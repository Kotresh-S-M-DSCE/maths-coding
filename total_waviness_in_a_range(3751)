class Solution {
    public int totalWaviness(int num1, int num2) {
        int ret=0;
        for(int i=num1;i<=num2;i++)
        {
            int[] arr=new int[6];
            int temp=i,n=5,count=0;
            while(temp>0)
            {
                arr[n--]=temp%10;
                temp/=10;
                count++;
            }
            temp=5;
            while(temp>=6-count)
            {
                if(temp!=5&&temp!=6-count)
                {
                    if(arr[temp]>arr[temp+1]&&arr[temp]>arr[temp-1])
                       ret++;
                    if(arr[temp]<arr[temp+1]&&arr[temp]<arr[temp-1])
                       ret++;
                }
                temp--;
            }
        }
        return ret;
    }
}