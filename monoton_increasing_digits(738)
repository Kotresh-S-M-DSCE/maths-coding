class Solution {
    public int monotoneIncreasingDigits(int n) {
        if(n<10)
           return n;
        List<Integer> list=new ArrayList<>();
        while(n>0)
        {
            list.add(0,n%10);
            n/=10;
        }
        Integer[] arr = list.toArray(new Integer[0]);
        int flag=0,temp=0;
        int i=arr.length-1,count=arr.length-1;
        while(i>0)
        {
            if(arr[i-1]>arr[i])
            {
                int j=i;
                while(j<=count)
                   arr[j++]=9;
                count=i;
                arr[i-1]--;
            }
            i--;
        }
        for(int j=0;j<arr.length;j++)
        {
            temp=temp*10+arr[j];
        }
        return temp;
    }
}