class Solution {
    public List<Integer> sequentialDigits(int low, int high) {
        int[] arr={1,2,3,4,5,6,7,8,9};
        List<Integer> list=new ArrayList<>();
        int i=0,j=1;
        while(i!=7||j!=8)
        {
            int n=arr[i];
            while(i<9&&j<9)
            {
                n=n*10+arr[j];
                if(n>=low&&n<=high)
                   list.add(n);
                else if(n>high)
                   break;
                else{}
                j++;
            }
            i++;
            j=i+1;
        } 
        if(low<=89&&high>=89)
           list.add(89);
        Collections.sort(list);
        return list;  
    }
}