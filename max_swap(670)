class Solution {
    public int maximumSwap(int num) {
        int[] arr=new int[8];
        int i=0;
        while(num>0)
        {
            arr[i++]=num%10;
            num/=10;
        }
        int n=i-1;
        for(int j=0;j<i/2;j++)
        {
            int temp=arr[j];
            arr[j]=arr[n];
            arr[n]=temp;
            n--;
        }
        int flag=0,indj=0,indk=0;
        for(int j=0;j<i;j++)
        {
            int max=arr[j],fla=0;
            indj=j;
            for(int k=j+1;k<i;k++)
            {
                if(arr[j]<arr[k])
                {
                   fla=1;
                   break;
                }
            }
            if(fla==1)
            {
            for(int k=j+1;k<i;k++)
            {
                if(max<=arr[k])
                {
                   flag=1; 
                   indk=k;
                   max=arr[k];
                }
            }
            }
            if(flag==1)
               break;
        }
        if(flag==1)
        {
            int temp=arr[indj];
            arr[indj]=arr[indk];
            arr[indk]=temp;
        }
        int ret=0;
        for(int j=0;j<i;j++)
            ret=ret*10+arr[j];
        return ret;
    }
}