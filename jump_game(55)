class Solution {
    public boolean canJump(int[] nums) {
        for(int i=0;i<nums.length-1;i++)
        {
            if(nums[i]==0)
            {
                int temp=i-1;
                while(temp>=0)
                {
                    if((nums[temp]+temp)>i)
                       break;
                    temp--;
                }
                if(temp<0)
                    return false;
            }
        } 
        return true;
    }
}