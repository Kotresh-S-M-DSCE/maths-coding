class Solution {
    public List<Integer> selfDividingNumbers(int left, int right) {
        List<Integer> arr=new ArrayList<>();
        for(int i=left;i<=right;i++)
        {
            int temp=i,flag=0;
            while(temp>0)
            {
                if(temp%10==0||i%(temp%10)!=0)
                {
                    flag=1;
                    break;
                }
                temp/=10;
            }
            if(flag==0)
               arr.add(i);
        }
        return arr;
    }
}