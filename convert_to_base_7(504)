class Solution {
    public String convertToBase7(int num) {
        if(num==0)
           return "0";
        StringBuilder sb=new StringBuilder();
        int flag=0;
        if(num<0)
        {
            num=-(num);
            flag=1;
        }
        while(num>0)
        {
            sb.insert(0,num%7);
            num/=7;
        }
        if(flag==1)
           sb.insert(0,'-');
        return sb.toString();
    }
}