class Solution {
    Set<Integer> ret=new LinkedHashSet<>();
    public void fun(int n,int st)
    {
        if(st==0)
           st+=1;
        else
           st*=10;
        if(st>n)
           return;
        for(int i=0;i<=9&&st<=n;i++)
        {
            ret.add(st);
            fun(n,st);
            st++;
        }
    }
    public List<Integer> lexicalOrder(int n) {
        // n=131 1 10 100 101 102 103 104 105 106 107 108 109 11 110 111
        fun(n,0);
        return new ArrayList<>(ret);
    }
}