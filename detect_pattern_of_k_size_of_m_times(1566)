class Solution {
    public boolean containsPattern(int[] arr, int m, int k) {
        for(int i=0;i<arr.length-m;i++)
        {
            int[] temp=new int[m];
            int j,count=1,a=0;
            for(j=i;j<(i+m);j++)
               temp[j-i]=arr[j];
            while(j<arr.length)
            {
                if(temp[a++]!=arr[j])
                   break;
                if(a==m)
                {
                    count++;
                    if(count>=k)
                       return true;
                    a=0;
                }
                j++;
            }
        }
        return false;
    }
}