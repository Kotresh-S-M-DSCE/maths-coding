class Solution {
    int max=0;
    public void fun(int[][] students,int[][] mentors,int row,List<List<Integer>> list,boolean[] bool)
    {
        if(row==students.length)
        {
            int count=0;
            for(int i=0;i<students.length;i++)
            {
                for(int j=0;j<students[0].length;j++)
                {
                    if(list.get(i).get(j)==mentors[i][j])
                       count++;
                }
            }
            if(count>max)
               max=count;
            return;
        }
        for(int j=0;j<students.length;j++)
        {
            if(bool[j]==false)
            {
                List<Integer> temp=new ArrayList<>();
                for(int i=0;i<students[0].length;i++)
                   temp.add(students[j][i]);
                list.add(temp);
                bool[j]=true;
                fun(students,mentors,row+1,list,bool);
                list.remove(list.size()-1);
                bool[j]=false;
            }
        }   
    }
    public int maxCompatibilitySum(int[][] students, int[][] mentors) {
        boolean[] bool=new boolean[students.length];
        for(int i=0;i<students.length;i++)
           bool[i]=false;
        fun(students,mentors,0,new ArrayList<>(),bool);
        return max;
    }
}