class Solution {
    List<List<String>> ret=new ArrayList<>();
    public String str(List<Integer> list,int ind)
    {
        StringBuilder sb=new StringBuilder();
        for(int i=0;i<list.size();i++)
        {
            if(i==ind)
               sb.append('Q');
            else
               sb.append('.');
        }
        return sb.toString();
    }
    public void fun(int n,int row,List<Integer> list)
    {
        if(row==n)
        {
            List<String> app=new ArrayList<>();
            for(int i=0;i<list.size();i++)
                app.add(str(list,list.get(i)));
            ret.add(app);
            return;
        }
        for(int i=0;i<n;i++)
        {
            boolean bool=true;
            for(int j=0;j<list.size();j++)
            {
                if((list.get(j)==i)||(Math.abs(row-j)==Math.abs(i-list.get(j))))
                {
                    bool=false;
                    break;
                }
            }
            if(bool==true)
            {
                list.add(i);
                fun(n,row+1,list);
                list.remove(list.size()-1);
            }
        }
    }
    public List<List<String>> solveNQueens(int n) {
        fun(n,0,new ArrayList<>());
        return ret;
    }
}