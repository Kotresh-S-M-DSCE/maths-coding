class Solution {
    public boolean sumOfNumberAndReverse(int num) {
        if(num<10)
        {
            if(num%2==0)
               return true;
            return false;
        }
        for(int i=num;i>=num/2;i--)
        {
            int temp=i,rev=0;
            while(temp>0)
            {
                rev=rev*10+temp%10;
                temp/=10;
            }
            if(i+rev==num)
               return true;
        }
        return false;
    }
}