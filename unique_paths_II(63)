class Solution {
    public int uniquePathsWithObstacles(int[][] obstacleGrid) {
        if(obstacleGrid[0][0]==1)
            return 0;
        if(obstacleGrid[0].length==1)
        {
            for(int i=0;i<obstacleGrid.length;i++)
            {
                if(obstacleGrid[i][0]==1)
                   return 0;
            }
            return 1;
        }
        int[][] arr=new int[obstacleGrid.length][obstacleGrid[0].length];
        int flag=0;
        for(int i=0;i<obstacleGrid.length;i++)
        {
            for(int j=0;j<obstacleGrid[0].length;j++)
            {
                if((i==0||j==0)&&obstacleGrid[i][j]==0&&flag==0)
                    arr[i][j]=1;
                else if(i==0&&obstacleGrid[i][j]==1)
                {
                    while(j!=obstacleGrid[0].length)
                    {
                        arr[i][j]=0;
                        j++;
                    }
                }  
                else if(j==0&&obstacleGrid[i][j]==1)
                {
                    int temp=i;
                    while(i!=obstacleGrid.length)
                    {
                        flag=1;
                        arr[i][j]=0;
                        i++;
                    }
                    i=temp;
                }
                else if(i!=0&&j!=0)
                {
                    if(obstacleGrid[i][j]==0)
                       arr[i][j]=arr[i-1][j]+arr[i][j-1];
                    else
                       arr[i][j]=0;
                }
                else
                   continue;
            }
        }
        return arr[obstacleGrid.length-1][obstacleGrid[0].length-1];
    }
}