class Solution {
    public int climbStairs(int n) {
        if(n==1)
        {
            return 1;
        }   
        if(n==2)
        {
            return 2;
        }
        int c=0,a=1,b=2,count=2;
        while(count<n)
        {
            c=a+b;
            a=b;
            b=c;
            count++;
        }
        return c;
    }
}