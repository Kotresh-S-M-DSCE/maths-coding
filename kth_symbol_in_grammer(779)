class Solution {
    public int fun(int n,int k)
    {
        if(k==1||n==1)
           return 0;
        if(k%2==1)
            return fun(n-1,(k+1)/2);
        else
        {
            if(fun(n-1,k/2)==0)
               return 1;
        }
        return 0;
    }
    public int kthGrammar(int n, int k) {
        // 0
        // 01
        // 0110
        // 01101001
        // 0110100110010110
        // 01101001100101101001011001101001
        return fun(n,k);
    }
}