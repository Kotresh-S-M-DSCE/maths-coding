class Solution {
    public double myPow(double x, int n) {
        double pow=1;
        if(n==0||x==1||(x==-1&&n%2==0))
        {
            return 1;
        }
        if(x==-1&&n%2!=0)
        {
            return -1;
        }
        if((x<=0.001&&x>=0)||n==-2147483648)
        {
            return 0;
        }
        if(n<0)
        {
           x=1/x;
           n=-n;
        }
        for(int i=1;i<=n;i++)
        {
            pow=pow*x;
        }
        return pow;
    }
}