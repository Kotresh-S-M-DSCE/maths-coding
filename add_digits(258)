class Solution {
    public int add(int num)
    {
        int rem,sum=0;
        while(num>0)
        {
            rem=num%10;
            sum+=rem;
            num/=10;
        }
        return sum;
    }
    public int addDigits(int num) {
        while(num>9)
            num=add(num);
        return num;
    }
}